# SmartPlot API Gateway Configuration
PORT=5000
NODE_ENV=development

# Upstream Python / FastAPI AI Microservice URL
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=15000

# Authentication & Security
REQUIRE_AUTH=false
INTERNAL_API_KEY=smartplot-internal-dev-key

# Client CORS
CORS_ORIGIN=*
