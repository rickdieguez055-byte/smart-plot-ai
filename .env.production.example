# ==============================================================================
# SmartPlot AI — Production Environment Configuration Template
# ==============================================================================

# Node.js API Gateway Configuration
PORT=5000
NODE_ENV=production
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=45000
CORS_ORIGIN=*
REQUIRE_AUTH=false
INTERNAL_API_KEY=smartplot-internal-prod-key

# FastAPI Microservice Configuration
APP_NAME=SmartPlot AI Microservice
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
ALLOWED_ORIGINS=["*"]
